diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 8faa61f89c66..d044b99c9a71 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -176,3 +176,23 @@ if(DEFINED RIME_SETUP_EXTRA_MODULES)
     PROPERTY COMPILE_DEFINITIONS
     "RIME_EXTRA_MODULES=${RIME_SETUP_EXTRA_MODULES}")
 endif()
+
+# Generate plugin module dependency code for static library builds.
+# When plugins are merged into the static library, their auto-registration
+# code (__attribute__((constructor))) can be discarded by the linker because
+# nothing references the plugin .o files.  We generate references to each
+# plugin's rime_require_module_*() function so that the linker keeps those
+# translation units alive.
+set(_rime_plugin_decls "")
+set(_rime_plugin_calls "")
+foreach(_mod ${rime_plugins_modules})
+  string(APPEND _rime_plugin_decls "extern void rime_require_module_${_mod}();\n")
+  string(APPEND _rime_plugin_calls "  rime_require_module_${_mod}();\n")
+endforeach()
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/rime_plugin_module_deps.inc"
+  "// Auto-generated by CMake -- do not edit\n"
+  "${_rime_plugin_decls}"
+  "static void rime_require_plugin_modules() {\n"
+  "${_rime_plugin_calls}"
+  "}\n"
+)
diff --git a/src/rime_api.cc b/src/rime_api.cc
index 1c0ead2abe82..2e62f8349897 100644
--- a/src/rime_api.cc
+++ b/src/rime_api.cc
@@ -26,12 +26,14 @@ extern void rime_require_module_core();
 extern void rime_require_module_dict();
 extern void rime_require_module_gears();
 extern void rime_require_module_levers();
+#include <rime_plugin_module_deps.inc>
 // link to default modules explicitly when building static library.
 void rime_declare_module_dependencies() {
   rime_require_module_core();
   rime_require_module_dict();
   rime_require_module_gears();
   rime_require_module_levers();
+  rime_require_plugin_modules();
 }
 #endif
 
