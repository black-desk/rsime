From 363fbbaf10cb619518ffbfa5c5682d02435b7335 Mon Sep 17 00:00:00 2001
From: Chen Linxuan <me@black-desk.cn>
Date: Fri, 5 Jun 2026 20:47:03 +0800
Subject: [PATCH] build: find lua via CMake's FindLua module

Replace the custom lua discovery logic (pkg-config fallback loop +
in-tree source build) with a simple find_package(Lua REQUIRED) call.

In the vcpkg environment, find_package(Lua) is intercepted by
vcpkg's cmake wrapper (ports/lua/vcpkg-cmake-wrapper.cmake.in),
which redirects to the unofficial-lua config package.  The wrapper
sets LUA_LIBRARIES to "lua" and LUA_INCLUDE_DIR, and creates an
imported target named "lua" (from unofficial-luaConfig.cmake).

The set_target_properties(lua PROPERTIES IMPORTED_GLOBAL TRUE) call
makes this imported target visible to the parent librime build, which
needs to link against it when merging plugins into the static library.

plugin_deps is changed from ${LUA_TARGET} (PkgConfig::LUA, no longer
set) to ${LUA_LIBRARIES} (set by the vcpkg wrapper to "lua").

Signed-off-by: Chen Linxuan <me@black-desk.cn>
---
 CMakeLists.txt | 42 ++++--------------------------------------
 1 file changed, 4 insertions(+), 38 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 42f2ebba6468..3007ede358e7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,40 +1,6 @@
-set(LUA_VERSION "lua" CACHE STRING "lua version")
-if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/lua5.4/lua.h")
-  find_package(PkgConfig)
-  if(PkgConfig_FOUND)
-    foreach(pkg ${LUA_VERSION} lua54 lua53 lua52 luajit lua51)
-      pkg_check_modules(LUA IMPORTED_TARGET GLOBAL ${pkg})
-      if(LUA_FOUND)
-	break()
-      endif()
-    endforeach()
-  endif()
-  if(LUA_FOUND)
-    set(LUA_TARGET PkgConfig::LUA)
-    include_directories(${LUA_INCLUDE_DIRS})
-  else()
-    message(FATAL_ERROR "Lua not found, consider using `bash action-install.sh` to download.")
-  endif()
-else()
-  message(STATUS "Using in-tree lua source")
-  include_directories(thirdparty/lua5.4)
-  aux_source_directory(thirdparty/lua5.4 LUA_SRC)
-  add_definitions(-DLUA_COMPAT_5_3)
-  if(WIN32)
-    set_property(SOURCE ${LUA_SRC} PROPERTY COMPILE_DEFINITIONS LUA_BUILD_AS_DLL)
-  else()
-    set_property(SOURCE ${LUA_SRC} PROPERTY COMPILE_DEFINITIONS LUA_USE_POSIX;LUA_USE_DLOPEN)
-    execute_process(
-      COMMAND ${CMAKE_C_COMPILER} -print-multiarch
-      OUTPUT_VARIABLE multiarch
-      ERROR_QUIET)
-    if(multiarch)
-      string(REGEX REPLACE "[\r\n]" "" multiarch ${multiarch})
-      add_definitions(-DLUA_MULTIARCH=\"${multiarch}\")
-      message(STATUS "with multiarch: ${multiarch}")
-    endif()
-  endif()
-endif()
+find_package(Lua REQUIRED)
+set_target_properties(lua PROPERTIES IMPORTED_GLOBAL TRUE)
+include_directories(${LUA_INCLUDE_DIR})
 
 aux_source_directory(src RIME_LUA_SRC)
 aux_source_directory(src/lib RIME_LUA_LIB_SRC)
@@ -46,5 +12,5 @@ endif()
 
 set(plugin_name "rime-lua" PARENT_SCOPE)
 set(plugin_objs $<TARGET_OBJECTS:rime-lua-objs> PARENT_SCOPE)
-set(plugin_deps ${LUA_TARGET} ${rime_library} ${rime_gears_library} PARENT_SCOPE)
+set(plugin_deps ${LUA_LIBRARIES} ${rime_library} ${rime_gears_library} PARENT_SCOPE)
 set(plugin_modules "lua" PARENT_SCOPE)
